# ---------------------------------------------------------------
# これは設定例（サンプル値）です。Git 管理します。
# 実際の値は .env.local に書いてください（.env.local は Git 管理対象外）。
#   cp .env.example .env.local
#
# EXPO_PUBLIC_ で始まる値はアプリに埋め込まれ、公開されます。
# 公開してよい値（URL と Publishable Key）だけを書くこと。
# Secret Key / service_role キーは絶対に書かない（アプリに含めない）。
# Publishable Key は公開前提です。データは RLS（行レベルセキュリティ）で保護します。
# ---------------------------------------------------------------

# Supabase の Project URL（ダッシュボード > Project Settings > API）
EXPO_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# Supabase の Publishable Key（sb_publishable_ で始まるキー）
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
